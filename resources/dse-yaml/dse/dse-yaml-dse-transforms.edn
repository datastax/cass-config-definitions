                                        :fields
                                        {:refresh_interval_in_ms {:type "int"
                                                                  :required true
                                                                  :default_value 60000
                                                                  :unit "milliseconds"}}}
                          :gremlin_server {:type "dict",
                                           :order [:port
                                                   :maxContentLength
                                                   :maxChunkSize]
                                           :fields
