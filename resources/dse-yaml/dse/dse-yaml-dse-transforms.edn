                                                    :value_type "string"},
                                      :observed_graphs {:type "list",
                                                        :value_type "string"},
                                      :slow_threshold_in_ms {:type "int",
                                                             :default_value 300000
                                                             :required true
                                                             :unit "milliseconds"},
                                      ;; according to dse.yaml comments, the only valid options here are "slf4j" and "slow_request".
